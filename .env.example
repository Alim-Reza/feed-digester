# Directory for the SQLite database, saved images, logs, and HTML snapshots.
# Defaults to ./data if unset.
# DATA_DIR=./data

# Ollama host for local inference (gemma4, embeddinggemma).
# Defaults to http://localhost:11434 if unset.
# OLLAMA_HOST=http://localhost:11434

# Optional: only needed if a pipeline stage is configured to use Groq
# instead of the local Ollama models.
# GROQ_API_KEY=

# Optional: pino log level (trace|debug|info|warn|error|fatal).
# LOG_LEVEL=info
