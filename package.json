{
  "name": "feed-digester",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"next dev\" \"tsx watch src/worker/main.ts\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "next build",
    "start": "concurrently -n web,worker -c blue,green \"next start\" \"tsx src/worker/main.ts\"",
    "start:web": "next start",
    "start:worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "collect:fixtures": "tsx scripts/capture-fixtures.ts",
    "diagnose:feed": "tsx scripts/diagnose-feed.ts",
    "login": "tsx scripts/login.ts",
    "evaluate:classifiers": "tsx scripts/evaluate-classifiers.ts",
    "compare:classifiers": "tsx scripts/dump-classifier-comparison.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.48",
    "@base-ui/react": "^1.8.0",
    "@receptron/laya": "^0.1.2",
    "ai": "^7.0.113",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "franc": "^6.2.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "ollama-ai-provider-v2": "^4.0.1",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^5.0.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0"
}
